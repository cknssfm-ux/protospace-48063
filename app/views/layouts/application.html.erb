<!DOCTYPE html>
<html lang="ja">
  <head>
    <title>ProtoSpace</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <header class="header">
      <div class="inner">
        <div class="nav">
          <div class="nav__left">
            <%= link_to image_tag("logo.png", class: :logo, alt: "ProtoSpace"), "#" %>
          </div>
          <div class="nav__right">
            <%# ログインしているとき：ログアウト・New Proto ／ していないとき：ログイン・新規登録 %>
            <%= link_to "ログイン", "#", class: :nav__btn %>
            <%= link_to "新規登録", "#", class: :nav__btn %>
          </div>
        </div>
      </div>
    </header>

    <%= yield %>

    <footer class="footer">
      <p class="copyright">Copyright © PROTO SPACE All rights reserved.</p>
    </footer>
  </body>
</html>
